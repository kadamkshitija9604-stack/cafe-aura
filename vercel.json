{
  "redirects": [
    {
      "source": "/admin",
      "destination": "https://cafe-aura-lovat.vercel.app/login",
      "permanent": false
    },
    {
      "source": "/admin/dashboard",
      "destination": "https://cafe-aura-lovat.vercel.app/dashboard",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
