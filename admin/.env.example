# Cafe Aura Production Environment Configuration Template
# Copy this file to .env.local and configure for your deployment environment

# 1. PostgreSQL Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/cafe_aura
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_secure_password
PGDATABASE=cafe_aura

# 2. Public URLs
NEXT_PUBLIC_SITE_URL=http://localhost:5173
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000

# 3. Optional Firebase Authentication & Storage (if using cloud OAuth / storage)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
