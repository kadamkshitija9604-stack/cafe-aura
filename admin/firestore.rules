rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get current user document
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Helper to check user's role
    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }
    
    function isSuperAdmin() {
      return hasRole('super_admin');
    }
    
    function isAdmin() {
      return isSuperAdmin() || hasRole('admin');
    }
    
    function isManager() {
      return isAdmin() || hasRole('manager');
    }
    
    function isMenuManager() {
      return isManager() || hasRole('menu_manager');
    }
    
    function isStaffManager() {
      return isManager() || hasRole('staff_manager');
    }

    // --- MENU ITEMS ---
    match /menuItems/{itemId} {
      allow read: if true; // Publicly readable for website
      allow create, update: if isMenuManager();
      allow delete: if isAdmin() || isMenuManager();
    }

    // --- CATEGORIES ---
    match /categories/{categoryId} {
      allow read: if true; // Publicly readable for website
      allow create, update: if isMenuManager();
      allow delete: if isAdmin() || isMenuManager();
    }

    // --- STAFF DIRECTORY ---
    match /staff/{staffId} {
      allow read: if isAuthenticated();
      allow write: if isStaffManager();
    }

    // --- USER ACCOUNTS ---
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status']));
      allow delete: if isSuperAdmin();
    }

    // --- AUDIT LOGS ---
    match /auditLogs/{logId} {
      allow read: if isManager();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit trail
    }

    // --- SETTINGS ---
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
